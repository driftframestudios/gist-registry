{
  "$description": "Synthetic primitive material values for the pipeline exemplar.",
  "color": {
    "$type": "color",
    "cobalt": {
      "600": { "$value": { "colorSpace": "srgb", "components": [0.1450980392, 0.2745098039, 0.9607843137], "alpha": 1, "hex": "#2546f5" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.0941176471, 0.2, 0.7843137255], "alpha": 1, "hex": "#1833c8" } }
    },
    "cream": {
      "050": { "$value": { "colorSpace": "srgb", "components": [1, 0.9803921569, 0.9411764706], "alpha": 1, "hex": "#fffaf0" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.968627451, 0.937254902, 0.8470588235], "alpha": 1, "hex": "#f7efd8" } }
    },
    "ink": {
      "900": { "$value": { "colorSpace": "srgb", "components": [0.0666666667, 0.1568627451, 0.3019607843], "alpha": 1, "hex": "#11284d" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.031372549, 0.0784313725, 0.1529411765], "alpha": 1, "hex": "#081427" } }
    },
    "signal": {
      "lime": { "$value": { "colorSpace": "srgb", "components": [0.937254902, 1, 0.2705882353], "alpha": 1, "hex": "#efff45" } },
      "coral": { "$value": { "colorSpace": "srgb", "components": [1, 0.462745098, 0.4274509804], "alpha": 1, "hex": "#ff766d" } }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } }
  },
  "border": {
    "$type": "dimension",
    "thin": { "$value": { "value": 1, "unit": "px" } },
    "strong": { "$value": { "value": 2, "unit": "px" } }
  },
  "duration": {
    "$type": "duration",
    "quick": { "$value": { "value": 120, "unit": "ms" } }
  }
}
