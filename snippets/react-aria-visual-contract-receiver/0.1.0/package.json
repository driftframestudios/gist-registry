{
  "name": "react-aria-visual-contract-receiver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "verify:build": "node tools/verify-build.mjs",
    "test:model": "node --test tests/model.test.mjs tests/static-contract.test.mjs tests/build-boundaries.test.mjs",
    "test:dom": "vitest run tests/receiver.test.jsx",
    "test": "npm run test:model && npm run test:dom && npm run verify:build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-stately": "3.51.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
