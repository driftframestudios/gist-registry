{
  "name": "visual-pattern-artifact-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27",
      "onFail": "error"
    }
  },
  "scripts": {
    "check:node-runtime": "node ../../../tools/check-node-runtime.mjs",
    "build": "node tools/build-artifacts.mjs",
    "example": "node tools/build-artifacts.mjs --summary",
    "pretest": "npm run check:node-runtime",
    "test": "node --test tests/*.test.mjs",
    "install:browsers": "playwright install chromium firefox webkit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
