{
  "name": "cross-browser-visual-contract-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27",
      "onFail": "error"
    }
  },
  "scripts": {
    "check:node-runtime": "node ../../../tools/check-node-runtime.mjs",
    "pretest": "npm run check:node-runtime",
    "test": "node --test tests/*.test.mjs",
    "install:browsers": "playwright install chromium firefox webkit",
    "test:browser": "playwright test",
    "example": "node tools/run-example.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
